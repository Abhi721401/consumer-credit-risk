# Dockerfile.api — Consumer Credit Risk PD Scoring API
FROM python:3.11-slim

WORKDIR /app

# System deps for xgboost/scipy wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only what the API needs to run: source pipeline code, trained
# model artifacts, and the experiment-results metadata it reads at
# startup. Data/notebooks/dashboard are not needed inside this image.
COPY src/ ./src/
COPY api/ ./api/
COPY models/ ./models/
COPY reports/experiment_results.json ./reports/experiment_results.json

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
